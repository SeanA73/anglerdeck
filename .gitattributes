# Normalise line endings.
#
# Without this, core.autocrlf rewrites files to CRLF on checkout while the
# committed versions stay LF, so git reports large phantom diffs that contain
# no actual changes — which hides real changes during review.
#
# `text=auto` stores everything as LF in the repository and converts to the
# platform's native endings in the working tree.

* text=auto

# Files that must keep LF regardless of platform (shell scripts and anything
# executed on the Linux VPS).
*.sh   text eol=lf
*.mjs  text eol=lf

# Binary files — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.lockb binary
