# ReelSpot Environment Variables

# Supabase Configuration
VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Site URL (used for SEO canonical URLs and sitemap)
VITE_SITE_URL=https://reelspot.app

# Stripe (publishable key only — secret key goes in Supabase Edge Function secrets)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Analytics 4
VITE_GA_ID=G-XXXXXXXXXX

# Affiliate tracking IDs
VITE_AMAZON_AFFILIATE_TAG=reelspot-20
VITE_CLICKBANK_HOP_ID=your_clickbank_nickname
VITE_BOOKING_AFFILIATE_ID=your_booking_aid
VITE_AIRBNB_AFFILIATE_ID=your_airbnb_af_id

# Google AdSense (optional until approved)
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_SPOTS=
VITE_ADSENSE_SLOT_SPOT_DETAIL=
VITE_ADSENSE_SLOT_COMMUNITY=
VITE_ADSENSE_SLOT_MARKETPLACE=
