# AnglerDeck Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real values.
# See README.md for full context. See src/lib/env.ts for validation.

# ============================
# REQUIRED — App won't start without these
# ============================

# Supabase — Project Settings → API in the Supabase dashboard
VITE_SUPABASE_URL=https://REPLACE-WITH-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Site URL — used for SEO canonical URLs, redirects, and sitemap
VITE_SITE_URL=http://127.0.0.1:8080

# Stripe publishable key — Stripe dashboard → API keys → Publishable key
# Use pk_test_... for development, pk_live_... for production
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Stripe price IDs — Stripe dashboard → Products → click product → copy price IDs
VITE_STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_ME
VITE_STRIPE_PRICE_PRO_YEARLY=price_REPLACE_ME
VITE_STRIPE_PRICE_ELITE_MONTHLY=price_REPLACE_ME
VITE_STRIPE_PRICE_ELITE_YEARLY=price_REPLACE_ME

# ============================
# OPTIONAL — set these as they become relevant (see ROADMAP Phase 9)
# ============================

# Google Analytics 4 measurement ID
VITE_GA_ID=G-XXXXXXXXXX

# Affiliate tracking IDs (Phase 9 — Path B multi-revenue layer)
VITE_AMAZON_AFFILIATE_TAG=anglerdeck-20
VITE_CLICKBANK_HOP_ID=your_clickbank_nickname
VITE_BOOKING_AFFILIATE_ID=your_booking_aid
VITE_AIRBNB_AFFILIATE_ID=your_airbnb_af_id

# Google AdSense — apply after Phase 9 content depth achieved
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_SPOTS=
VITE_ADSENSE_SLOT_SPOT_DETAIL=
VITE_ADSENSE_SLOT_COMMUNITY=