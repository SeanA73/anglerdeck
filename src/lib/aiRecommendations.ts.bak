// AI-powered fishing recommendations engine
import { waterConditionsService, type WaterConditions } from './waterConditions';

export interface CatchData {
    id: string;
    species: string;
    weight?: number;
    length?: number;
    location: {
        lat: number;
        lon: number;
        name: string;
    };
    bait: string;
    lure?: string;
    weather: {
        temperature: number;
        pressure: number;
        windSpeed: number;
    };
    waterConditions: {
        temperature: number;
        clarity: string;
    };
    timeOfDay: 'dawn' | 'morning' | 'afternoon' | 'evening' | 'night';
    season: 'spring' | 'summer' | 'fall' | 'winter';
    caughtAt: Date;
}

export interface BaitRecommendation {
    name: string;
    type: 'live' | 'artificial' | 'lure';
    confidence: number;
    reason: string;
    affiliateProducts?: AffiliateProduct[];
}

export interface GearRecommendation {
    category: 'rod' | 'reel' | 'line' | 'tackle';
    name: string;
    specifications: string;
    confidence: number;
    reason: string;
    affiliateProducts?: AffiliateProduct[];
}

export interface SpotRecommendation {
    spotId: string;
    name: string;
    location: {
        lat: number;
        lon: number;
    };
    distance: number;
    confidence: number;
    predictedSpecies: string[];
    bestTime: string;
    reason: string;
}

export interface AffiliateProduct {
    id: string;
    name: string;
    price: number;
    rating: number;
    reviews: number;
    image: string;
    affiliateUrl: string;
    merchant: string;
}

interface RecommendationContext {
    userLocation: {
        lat: number;
        lon: number;
    };
    targetSpecies?: string;
    userHistory: CatchData[];
    currentConditions?: WaterConditions;
    timeOfDay: string;
    season: string;
}

class AIRecommendationEngine {
    /**
     * Get personalized bait recommendations
     */
    async getBaitRecommendations(
        context: RecommendationContext
    ): Promise<BaitRecommendation[]> {
        const recommendations: BaitRecommendation[] = [];

        // Analyze user's successful catches
        const successfulBaits = this.analyzeSuccessfulBaits(
            context.userHistory,
            context.targetSpecies
        );

        // Consider current conditions
        const conditionBasedBaits = await this.getConditionBasedBaits(
            context.currentConditions,
            context.targetSpecies,
            context.season
        );

        // Combine and rank recommendations
        const allBaits = [...successfulBaits, ...conditionBasedBaits];
        const rankedBaits = this.rankRecommendations(allBaits);

        // Add affiliate products for top recommendations
        for (const bait of rankedBaits.slice(0, 5)) {
            const products = await this.findAffiliateProducts(bait.name, 'bait');
            recommendations.push({
                ...bait,
                affiliateProducts: products,
            });
        }

        return recommendations;
    }

    /**
     * Get personalized gear recommendations
     */
    async getGearRecommendations(
        context: RecommendationContext
    ): Promise<GearRecommendation[]> {
        const recommendations: GearRecommendation[] = [];

        // Analyze what gear works for target species
        const speciesGear = this.getSpeciesSpecificGear(context.targetSpecies);

        // Consider user's skill level and history
        const userLevel = this.determineUserLevel(context.userHistory);

        // Generate recommendations based on level and species
        const gearRecs = this.generateGearRecommendations(
            speciesGear,
            userLevel,
            context.season
        );

        // Add affiliate products
        for (const gear of gearRecs) {
            const products = await this.findAffiliateProducts(
                gear.name,
                gear.category
            );
            recommendations.push({
                ...gear,
                affiliateProducts: products,
            });
        }

        return recommendations;
    }

    /**
     * Get personalized spot recommendations
     */
    async getSpotRecommendations(
        context: RecommendationContext
    ): Promise<SpotRecommendation[]> {
        // This would integrate with your spots database
        // For now, return a structured response

        const recommendations: SpotRecommendation[] = [];

        // Analyze user's successful spots
        const successfulSpots = this.analyzeSuccessfulSpots(context.userHistory);

        // Find similar spots nearby
        const nearbySpots = await this.findSimilarSpots(
            successfulSpots,
            context.userLocation
        );

        // Rank by predicted success
        const rankedSpots = await this.rankSpotsByPredictedSuccess(
            nearbySpots,
            context
        );

        return rankedSpots;
    }

    /**
     * Get real-time fishing recommendations
     */
    async getRealTimeRecommendations(
        context: RecommendationContext
    ): Promise<{
        overall: string;
        bait: BaitRecommendation[];
        gear: GearRecommendation[];
        spots: SpotRecommendation[];
        bestTime: string;
        fishingScore: number;
    }> {
        const [bait, gear, spots, fishingScore] = await Promise.all([
            this.getBaitRecommendations(context),
            this.getGearRecommendations(context),
            this.getSpotRecommendations(context),
            waterConditionsService.getFishingScore(
                context.userLocation.lat,
                context.userLocation.lon,
                context.targetSpecies
            ),
        ]);

        const bestTime = this.calculateBestFishingTime(
            context.currentConditions,
            context.season
        );

        let overall = 'Good conditions for fishing';
        if (fishingScore.score >= 80) {
            overall = 'Excellent conditions! Prime time for fishing.';
        } else if (fishingScore.score >= 60) {
            overall = 'Good conditions. You should have success.';
        } else if (fishingScore.score < 40) {
            overall = 'Challenging conditions. Consider waiting for better weather.';
        }

        return {
            overall,
            bait: bait.slice(0, 3),
            gear: gear.slice(0, 3),
            spots: spots.slice(0, 5),
            bestTime,
            fishingScore: fishingScore.score,
        };
    }

    /**
     * Predict catch success probability
     */
    async predictCatchSuccess(
        spotId: string,
        species: string,
        date: Date,
        userHistory: CatchData[]
    ): Promise<{
        probability: number;
        confidence: number;
        factors: {
            historical: number;
            conditions: number;
            timing: number;
            userSkill: number;
        };
        recommendations: string[];
    }> {
        // This is a simplified ML model
        // In production, you'd use TensorFlow.js or a backend ML service

        const historicalSuccess = this.calculateHistoricalSuccess(
            spotId,
            species,
            userHistory
        );

        const conditionsScore = 75; // Would get from water conditions
        const timingScore = this.calculateTimingScore(date);
        const userSkillScore = this.calculateUserSkillScore(userHistory, species);

        const probability =
            (historicalSuccess * 0.3 +
                conditionsScore * 0.3 +
                timingScore * 0.2 +
                userSkillScore * 0.2) /
            100;

        const confidence = this.calculateConfidence(userHistory.length);

        const recommendations = this.generateSuccessTips(
            probability,
            species,
            date
        );

        return {
            probability: Math.round(probability * 100),
            confidence,
            factors: {
                historical: historicalSuccess,
                conditions: conditionsScore,
                timing: timingScore,
                userSkill: userSkillScore,
            },
            recommendations,
        };
    }

    // Private helper methods

    private analyzeSuccessfulBaits(
        history: CatchData[],
        targetSpecies?: string
    ): BaitRecommendation[] {
        const baitCounts = new Map<string, number>();

        const relevantCatches = targetSpecies
            ? history.filter((c) => c.species.toLowerCase() === targetSpecies.toLowerCase())
            : history;

        relevantCatches.forEach((catch_) => {
            const count = baitCounts.get(catch_.bait) || 0;
            baitCounts.set(catch_.bait, count + 1);
        });

        return Array.from(baitCounts.entries())
            .map(([bait, count]) => ({
                name: bait,
                type: 'live' as const,
                confidence: Math.min(100, (count / relevantCatches.length) * 100),
                reason: `You've caught ${count} fish using this bait`,
            }))
            .sort((a, b) => b.confidence - a.confidence);
    }

    private async getConditionBasedBaits(
        conditions?: WaterConditions,
        species?: string,
        season?: string
    ): Promise<BaitRecommendation[]> {
        // Bait recommendations based on conditions and species
        const recommendations: BaitRecommendation[] = [];

        if (species?.toLowerCase() === 'bass') {
            if (conditions && conditions.temperature > 70) {
                recommendations.push({
                    name: 'Topwater Lures',
                    type: 'lure',
                    confidence: 85,
                    reason: 'Warm water temperatures favor topwater action',
                });
            } else {
                recommendations.push({
                    name: 'Jigs',
                    type: 'lure',
                    confidence: 80,
                    reason: 'Cooler water calls for slower presentations',
                });
            }
        }

        return recommendations;
    }

    private getSpeciesSpecificGear(species?: string): GearRecommendation[] {
        const gearMap: Record<string, GearRecommendation[]> = {
            bass: [
                {
                    category: 'rod',
                    name: 'Medium-Heavy Casting Rod',
                    specifications: '7ft, 12-20lb line rating',
                    confidence: 90,
                    reason: 'Ideal for bass fishing with various lures',
                },
                {
                    category: 'reel',
                    name: 'Baitcasting Reel',
                    specifications: '6.4:1 gear ratio',
                    confidence: 85,
                    reason: 'Provides accuracy and power for bass',
                },
            ],
            trout: [
                {
                    category: 'rod',
                    name: 'Light Spinning Rod',
                    specifications: '6-7ft, 4-8lb line rating',
                    confidence: 90,
                    reason: 'Perfect for trout fishing with light lures',
                },
            ],
        };

        return gearMap[species?.toLowerCase() || 'bass'] || [];
    }

    private determineUserLevel(history: CatchData[]): 'beginner' | 'intermediate' | 'expert' {
        if (history.length < 10) return 'beginner';
        if (history.length < 50) return 'intermediate';
        return 'expert';
    }

    private generateGearRecommendations(
        speciesGear: GearRecommendation[],
        userLevel: string,
        season?: string
    ): GearRecommendation[] {
        // Adjust recommendations based on user level
        return speciesGear.map((gear) => ({
            ...gear,
            confidence: userLevel === 'beginner' ? gear.confidence * 0.9 : gear.confidence,
        }));
    }

    private async findAffiliateProducts(
        searchTerm: string,
        category: string
    ): Promise<AffiliateProduct[]> {
        // This would query your affiliate products database
        // For now, return mock data
        return [];
    }

    private analyzeSuccessfulSpots(history: CatchData[]): string[] {
        const spotCounts = new Map<string, number>();

        history.forEach((catch_) => {
            const spotKey = `${catch_.location.lat},${catch_.location.lon}`;
            const count = spotCounts.get(spotKey) || 0;
            spotCounts.set(spotKey, count + 1);
        });

        return Array.from(spotCounts.entries())
            .sort((a, b) => b[1] - a[1])
            .slice(0, 5)
            .map(([spot]) => spot);
    }

    private async findSimilarSpots(
        successfulSpots: string[],
        userLocation: { lat: number; lon: number }
    ): Promise<SpotRecommendation[]> {
        // Would query spots database for similar characteristics
        return [];
    }

    private async rankSpotsByPredictedSuccess(
        spots: SpotRecommendation[],
        context: RecommendationContext
    ): Promise<SpotRecommendation[]> {
        return spots.sort((a, b) => b.confidence - a.confidence);
    }

    private calculateBestFishingTime(
        conditions?: WaterConditions,
        season?: string
    ): string {
        // Simplified - would use solunar data
        const hour = new Date().getHours();

        if (hour >= 5 && hour <= 8) return 'Now (Dawn - Best time!)';
        if (hour >= 17 && hour <= 20) return 'Evening (6-8 PM)';
        return 'Early morning (5-8 AM) or Evening (6-8 PM)';
    }

    private calculateHistoricalSuccess(
        spotId: string,
        species: string,
        history: CatchData[]
    ): number {
        const spotCatches = history.filter(
            (c) =>
                c.location.name === spotId &&
                c.species.toLowerCase() === species.toLowerCase()
        );

        return Math.min(100, (spotCatches.length / history.length) * 100 * 2);
    }

    private calculateTimingScore(date: Date): number {
        const hour = date.getHours();
        const month = date.getMonth();

        let score = 50;

        // Best times: dawn (5-8) and dusk (17-20)
        if ((hour >= 5 && hour <= 8) || (hour >= 17 && hour <= 20)) {
            score += 30;
        }

        // Spring and fall are generally better
        if (month >= 3 && month <= 5) score += 10; // Spring
        if (month >= 9 && month <= 11) score += 10; // Fall

        return Math.min(100, score);
    }

    private calculateUserSkillScore(
        history: CatchData[],
        species: string
    ): number {
        const speciesCatches = history.filter(
            (c) => c.species.toLowerCase() === species.toLowerCase()
        );

        const baseScore = Math.min(100, history.length * 2);
        const speciesBonus = Math.min(20, speciesCatches.length * 4);

        return Math.min(100, baseScore + speciesBonus);
    }

    private calculateConfidence(historyLength: number): number {
        return Math.min(100, historyLength * 5);
    }

    private generateSuccessTips(
        probability: number,
        species: string,
        date: Date
    ): string[] {
        const tips: string[] = [];

        if (probability < 0.5) {
            tips.push('Consider trying a different spot or time');
            tips.push('Check water conditions before heading out');
        } else {
            tips.push('Conditions look favorable!');
            tips.push(`Focus on areas where ${species} typically feed`);
        }

        const hour = date.getHours();
        if (hour < 5 || hour > 20) {
            tips.push('Early morning or evening would be better');
        }

        return tips;
    }

    private rankRecommendations<T extends { confidence: number }>(items: T[]): T[] {
        return items.sort((a, b) => b.confidence - a.confidence);
    }
}

export const aiRecommendationEngine = new AIRecommendationEngine();
