// Water conditions service integrating NOAA and OpenWeatherMap APIs
// TODO: Install axios to enable API calls: npm install axios
// import axios from 'axios';

// Mock axios until real package is installed
const axios = {
    get: async (url: string, config?: any): Promise<{ data: any }> => {
        console.warn('Axios not installed. Install with: npm install axios');
        return { data: {} };
    }
};

const NOAA_API_BASE = 'https://api.tidesandcurrents.noaa.gov/api/prod/datagetter';
const OPENWEATHER_API_BASE = 'https://api.openweathermap.org/data/3.0';

export interface WaterConditions {
    temperature: number;
    temperatureUnit: 'F' | 'C';
    tides: TideData[];
    currents: CurrentData | null;
    waves: WaveData | null;
    salinity: number | null;
    windSpeed: number;
    windDirection: number;
    pressure: number;
    visibility: number;
    timestamp: Date;
}

export interface TideData {
    time: Date;
    height: number;
    type: 'high' | 'low';
}

export interface CurrentData {
    speed: number;
    direction: number;
    timestamp: Date;
}

export interface WaveData {
    height: number;
    period: number;
    direction: number;
}

export interface WeatherForecast {
    date: Date;
    tempHigh: number;
    tempLow: number;
    precipitation: number;
    windSpeed: number;
    conditions: string;
    icon: string;
}

class WaterConditionsService {
    private noaaApiKey: string;
    private openWeatherApiKey: string;

    constructor() {
        this.noaaApiKey = import.meta.env.VITE_NOAA_API_KEY || '';
        this.openWeatherApiKey = import.meta.env.VITE_OPENWEATHER_API_KEY || '';
    }

    /**
     * Get current water conditions for a location
     */
    async getWaterConditions(
        lat: number,
        lon: number,
        stationId?: string
    ): Promise<WaterConditions> {
        try {
            const [tides, weather, currents] = await Promise.all([
                this.getTideData(lat, lon, stationId),
                this.getWeatherData(lat, lon),
                this.getCurrentData(lat, lon, stationId),
            ]);

            return {
                temperature: weather.main.temp,
                temperatureUnit: 'F',
                tides,
                currents,
                waves: null, // Would need additional API for wave data
                salinity: null,
                windSpeed: weather.wind.speed,
                windDirection: weather.wind.deg,
                pressure: weather.main.pressure,
                visibility: weather.visibility,
                timestamp: new Date(),
            };
        } catch (error) {
            console.error('Error fetching water conditions:', error);
            throw new Error('Failed to fetch water conditions');
        }
    }

    /**
     * Get tide predictions from NOAA
     */
    private async getTideData(
        lat: number,
        lon: number,
        stationId?: string
    ): Promise<TideData[]> {
        try {
            // If no station ID provided, find nearest station
            const station = stationId || (await this.findNearestStation(lat, lon));

            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);

            const params = {
                begin_date: today.toISOString().split('T')[0].replace(/-/g, ''),
                end_date: tomorrow.toISOString().split('T')[0].replace(/-/g, ''),
                station: station,
                product: 'predictions',
                datum: 'MLLW',
                time_zone: 'lst_ldt',
                interval: 'hilo',
                units: 'english',
                format: 'json',
            };

            const response = await axios.get(NOAA_API_BASE, { params });

            if (response.data.predictions) {
                return response.data.predictions.map((pred: any) => ({
                    time: new Date(pred.t),
                    height: parseFloat(pred.v),
                    type: pred.type === 'H' ? 'high' : 'low',
                }));
            }

            return [];
        } catch (error) {
            console.error('Error fetching tide data:', error);
            return [];
        }
    }

    /**
     * Get current data from NOAA
     */
    private async getCurrentData(
        lat: number,
        lon: number,
        stationId?: string
    ): Promise<CurrentData | null> {
        try {
            const station = stationId || (await this.findNearestStation(lat, lon));

            const params = {
                station: station,
                product: 'currents',
                date: 'latest',
                time_zone: 'lst_ldt',
                units: 'english',
                format: 'json',
            };

            const response = await axios.get(NOAA_API_BASE, { params });

            if (response.data.data && response.data.data.length > 0) {
                const current = response.data.data[0];
                return {
                    speed: parseFloat(current.s),
                    direction: parseFloat(current.d),
                    timestamp: new Date(current.t),
                };
            }

            return null;
        } catch (error) {
            console.error('Error fetching current data:', error);
            return null;
        }
    }

    /**
     * Get weather data from OpenWeatherMap
     */
    private async getWeatherData(lat: number, lon: number): Promise<any> {
        try {
            const response = await axios.get(
                `${OPENWEATHER_API_BASE}/onecall`,
                {
                    params: {
                        lat,
                        lon,
                        appid: this.openWeatherApiKey,
                        units: 'imperial',
                        exclude: 'minutely,alerts',
                    },
                }
            );

            return response.data.current;
        } catch (error) {
            console.error('Error fetching weather data:', error);
            throw error;
        }
    }

    /**
     * Get 7-day weather forecast (Pro feature)
     */
    async getWeatherForecast(lat: number, lon: number): Promise<WeatherForecast[]> {
        try {
            const response = await axios.get(
                `${OPENWEATHER_API_BASE}/onecall`,
                {
                    params: {
                        lat,
                        lon,
                        appid: this.openWeatherApiKey,
                        units: 'imperial',
                        exclude: 'current,minutely,hourly,alerts',
                    },
                }
            );

            return response.data.daily.map((day: any) => ({
                date: new Date(day.dt * 1000),
                tempHigh: day.temp.max,
                tempLow: day.temp.min,
                precipitation: day.pop * 100,
                windSpeed: day.wind_speed,
                conditions: day.weather[0].description,
                icon: day.weather[0].icon,
            }));
        } catch (error) {
            console.error('Error fetching weather forecast:', error);
            throw error;
        }
    }

    /**
     * Find nearest NOAA station
     */
    private async findNearestStation(lat: number, lon: number): Promise<string> {
        // This is a simplified version - in production, you'd query NOAA's station API
        // For now, return a default station ID
        // You should implement proper station lookup based on coordinates
        return '8454000'; // Providence, RI - example station
    }

    /**
     * Calculate solunar periods (best fishing times)
     */
    calculateSolunarPeriods(date: Date, lat: number, lon: number): {
        major: { start: Date; end: Date }[];
        minor: { start: Date; end: Date }[];
    } {
        // Simplified solunar calculation
        // In production, use a proper solunar library or API
        const major: { start: Date; end: Date }[] = [];
        const minor: { start: Date; end: Date }[] = [];

        // Major periods occur at moonrise and moonset (2 hours each)
        // Minor periods occur at moon overhead and underfoot (1 hour each)
        // This is a placeholder - implement proper astronomical calculations

        return { major, minor };
    }

    /**
     * Get fishing conditions score (0-100)
     */
    async getFishingScore(
        lat: number,
        lon: number,
        species?: string
    ): Promise<{
        score: number;
        factors: {
            temperature: number;
            pressure: number;
            tides: number;
            weather: number;
            solunar: number;
        };
        recommendation: string;
    }> {
        try {
            const conditions = await this.getWaterConditions(lat, lon);

            // Calculate individual factor scores
            const tempScore = this.calculateTemperatureScore(
                conditions.temperature,
                species
            );
            const pressureScore = this.calculatePressureScore(conditions.pressure);
            const tideScore = this.calculateTideScore(conditions.tides);
            const weatherScore = this.calculateWeatherScore(
                conditions.windSpeed,
                conditions.visibility
            );
            const solunarScore = 70; // Placeholder

            const totalScore = Math.round(
                (tempScore + pressureScore + tideScore + weatherScore + solunarScore) / 5
            );

            let recommendation = 'Fair';
            if (totalScore >= 80) recommendation = 'Excellent';
            else if (totalScore >= 60) recommendation = 'Good';
            else if (totalScore < 40) recommendation = 'Poor';

            return {
                score: totalScore,
                factors: {
                    temperature: tempScore,
                    pressure: pressureScore,
                    tides: tideScore,
                    weather: weatherScore,
                    solunar: solunarScore,
                },
                recommendation,
            };
        } catch (error) {
            console.error('Error calculating fishing score:', error);
            throw error;
        }
    }

    private calculateTemperatureScore(temp: number, species?: string): number {
        // Optimal temperature ranges for different species
        const optimalRanges: Record<string, { min: number; max: number }> = {
            bass: { min: 60, max: 75 },
            trout: { min: 50, max: 65 },
            salmon: { min: 45, max: 60 },
            default: { min: 55, max: 70 },
        };

        const range = optimalRanges[species?.toLowerCase() || 'default'];
        const optimal = (range.min + range.max) / 2;
        const deviation = Math.abs(temp - optimal);
        const maxDeviation = (range.max - range.min) / 2;

        return Math.max(0, 100 - (deviation / maxDeviation) * 100);
    }

    private calculatePressureScore(pressure: number): number {
        // Optimal pressure: 29.90 - 30.20 inHg (1012-1023 hPa)
        const optimal = 1017.5;
        const deviation = Math.abs(pressure - optimal);
        return Math.max(0, 100 - deviation * 5);
    }

    private calculateTideScore(tides: TideData[]): number {
        // Best fishing during tide changes
        const now = new Date();
        const nextTide = tides.find((t) => t.time > now);

        if (!nextTide) return 50;

        const timeUntilTide = nextTide.time.getTime() - now.getTime();
        const hoursUntilTide = timeUntilTide / (1000 * 60 * 60);

        // Best fishing 1-2 hours before tide change
        if (hoursUntilTide >= 1 && hoursUntilTide <= 2) return 100;
        if (hoursUntilTide >= 0.5 && hoursUntilTide <= 3) return 80;
        return 50;
    }

    private calculateWeatherScore(windSpeed: number, visibility: number): number {
        let score = 100;

        // Reduce score for high winds
        if (windSpeed > 15) score -= (windSpeed - 15) * 3;

        // Reduce score for low visibility
        if (visibility < 5000) score -= (5000 - visibility) / 100;

        return Math.max(0, Math.min(100, score));
    }
}

export const waterConditionsService = new WaterConditionsService();
