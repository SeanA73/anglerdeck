// Firebase Cloud Messaging push notification service
import { initializeApp, type FirebaseApp } from 'firebase/app';
import {
    getMessaging,
    getToken,
    onMessage,
    type Messaging,
} from 'firebase/messaging';
import { supabase } from '@/integrations/supabase/client';

export interface NotificationPreferences {
    weatherAlerts: boolean;
    primeFishingWindows: boolean;
    marketplaceDeals: boolean;
    communityUpdates: boolean;
    catchReminders: boolean;
    spotRecommendations: boolean;
}

export interface PushNotification {
    title: string;
    body: string;
    icon?: string;
    data?: Record<string, any>;
    action?: string;
}

class PushNotificationService {
    private app: FirebaseApp | null = null;
    private messaging: Messaging | null = null;
    private vapidKey: string;

    constructor() {
        this.vapidKey = import.meta.env.VITE_FIREBASE_VAPID_KEY || '';
        this.initialize();
    }

    /**
     * Initialize Firebase
     */
    private initialize() {
        try {
            const firebaseConfig = {
                apiKey: import.meta.env.VITE_FIREBASE_API_KEY,
                authDomain: import.meta.env.VITE_FIREBASE_AUTH_DOMAIN,
                projectId: import.meta.env.VITE_FIREBASE_PROJECT_ID,
                storageBucket: import.meta.env.VITE_FIREBASE_STORAGE_BUCKET,
                messagingSenderId: import.meta.env.VITE_FIREBASE_MESSAGING_SENDER_ID,
                appId: import.meta.env.VITE_FIREBASE_APP_ID,
            };

            this.app = initializeApp(firebaseConfig);
            this.messaging = getMessaging(this.app);
        } catch (error) {
            console.error('Error initializing Firebase:', error);
        }
    }

    /**
     * Request notification permission and get FCM token
     */
    async requestPermission(): Promise<string | null> {
        try {
            const permission = await Notification.requestPermission();

            if (permission === 'granted' && this.messaging) {
                const token = await getToken(this.messaging, {
                    vapidKey: this.vapidKey,
                });

                // Save token to database
                await this.saveTokenToDatabase(token);

                return token;
            }

            return null;
        } catch (error) {
            console.error('Error requesting notification permission:', error);
            return null;
        }
    }

    /**
     * Save FCM token to database
     */
    private async saveTokenToDatabase(token: string) {
        try {
            const { data: { user } } = await supabase.auth.getUser();

            if (user) {
                await supabase.from('fcm_tokens').upsert({
                    user_id: user.id,
                    token,
                    updated_at: new Date().toISOString(),
                });
            }
        } catch (error) {
            console.error('Error saving FCM token:', error);
        }
    }

    /**
     * Listen for foreground messages
     */
    onMessageReceived(callback: (payload: any) => void) {
        if (this.messaging) {
            onMessage(this.messaging, (payload) => {
                console.log('Message received:', payload);
                callback(payload);

                // Show notification if app is in foreground
                if (payload.notification) {
                    this.showNotification({
                        title: payload.notification.title || 'ReelSpot',
                        body: payload.notification.body || '',
                        icon: payload.notification.icon,
                        data: payload.data,
                    });
                }
            });
        }
    }

    /**
     * Show browser notification
     */
    private showNotification(notification: PushNotification) {
        if ('Notification' in window && Notification.permission === 'granted') {
            new Notification(notification.title, {
                body: notification.body,
                icon: notification.icon || '/icon-192.png',
                badge: '/badge-72.png',
                data: notification.data,
            });
        }
    }

    /**
     * Get user's notification preferences
     */
    async getNotificationPreferences(): Promise<NotificationPreferences> {
        try {
            const { data: { user } } = await supabase.auth.getUser();

            if (user) {
                const { data } = await supabase
                    .from('notification_preferences')
                    .select('*')
                    .eq('user_id', user.id)
                    .single();

                if (data) {
                    return {
                        weatherAlerts: data.weather_alerts,
                        primeFishingWindows: data.prime_fishing_windows,
                        marketplaceDeals: data.marketplace_deals,
                        communityUpdates: data.community_updates,
                        catchReminders: data.catch_reminders,
                        spotRecommendations: data.spot_recommendations,
                    };
                }
            }

            // Default preferences
            return {
                weatherAlerts: true,
                primeFishingWindows: true,
                marketplaceDeals: false,
                communityUpdates: false,
                catchReminders: true,
                spotRecommendations: true,
            };
        } catch (error) {
            console.error('Error getting notification preferences:', error);
            throw error;
        }
    }

    /**
     * Update notification preferences
     */
    async updateNotificationPreferences(
        preferences: Partial<NotificationPreferences>
    ): Promise<void> {
        try {
            const { data: { user } } = await supabase.auth.getUser();

            if (user) {
                await supabase.from('notification_preferences').upsert({
                    user_id: user.id,
                    weather_alerts: preferences.weatherAlerts,
                    prime_fishing_windows: preferences.primeFishingWindows,
                    marketplace_deals: preferences.marketplaceDeals,
                    community_updates: preferences.communityUpdates,
                    catch_reminders: preferences.catchReminders,
                    spot_recommendations: preferences.spotRecommendations,
                    updated_at: new Date().toISOString(),
                });
            }
        } catch (error) {
            console.error('Error updating notification preferences:', error);
            throw error;
        }
    }

    /**
     * Schedule weather alert notifications
     */
    async scheduleWeatherAlert(
        location: { lat: number; lon: number },
        condition: string
    ) {
        // This would be handled by a backend service
        // For now, just log the intent
        console.log('Weather alert scheduled:', { location, condition });
    }

    /**
     * Schedule prime fishing window notification
     */
    async schedulePrimeFishingNotification(
        spotId: string,
        time: Date
    ) {
        console.log('Prime fishing notification scheduled:', { spotId, time });
    }

    /**
     * Send marketplace deal notification
     */
    async sendMarketplaceDealNotification(
        productId: string,
        dealDetails: string
    ) {
        console.log('Marketplace deal notification:', { productId, dealDetails });
    }

    /**
     * Unsubscribe from all notifications
     */
    async unsubscribeAll() {
        try {
            const { data: { user } } = await supabase.auth.getUser();

            if (user) {
                // Delete FCM token
                await supabase
                    .from('fcm_tokens')
                    .delete()
                    .eq('user_id', user.id);

                // Update preferences to disable all
                await this.updateNotificationPreferences({
                    weatherAlerts: false,
                    primeFishingWindows: false,
                    marketplaceDeals: false,
                    communityUpdates: false,
                    catchReminders: false,
                    spotRecommendations: false,
                });
            }
        } catch (error) {
            console.error('Error unsubscribing from notifications:', error);
            throw error;
        }
    }
}

export const pushNotificationService = new PushNotificationService();
