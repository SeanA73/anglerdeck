import { useEffect, useState } from 'react';
import { useQuery } from '@tanstack/react-query';
import { motion } from 'framer-motion';
import {
    Droplets,
    Wind,
    Thermometer,
    Waves,
    TrendingUp,
    TrendingDown,
    Activity,
} from 'lucide-react';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Skeleton } from '@/components/ui/skeleton';
import { waterConditionsService, type WaterConditions } from '@/lib/waterConditions';
// Recharts removed - will add back when needed with: npm install recharts
// import { LineChart, Line, XAxis, YAxis, Tooltip, ResponsiveContainer } from 'recharts';
import { cn } from '@/lib/utils';

interface WaterConditionsDashboardProps {
    lat: number;
    lon: number;
    spotName?: string;
}

export const WaterConditionsDashboard = ({
    lat,
    lon,
    spotName,
}: WaterConditionsDashboardProps) => {
    const { data: conditions, isLoading } = useQuery({
        queryKey: ['water-conditions', lat, lon],
        queryFn: () => waterConditionsService.getWaterConditions(lat, lon),
        refetchInterval: 5 * 60 * 1000, // Refetch every 5 minutes
    });

    const { data: fishingScore } = useQuery({
        queryKey: ['fishing-score', lat, lon],
        queryFn: () => waterConditionsService.getFishingScore(lat, lon),
        refetchInterval: 10 * 60 * 1000,
    });

    if (isLoading) {
        return (
            <div className="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
                {[...Array(4)].map((_, i) => (
                    <Card key={i}>
                        <CardHeader>
                            <Skeleton className="h-4 w-24" />
                        </CardHeader>
                        <CardContent>
                            <Skeleton className="h-8 w-16" />
                        </CardContent>
                    </Card>
                ))}
            </div>
        );
    }

    if (!conditions) {
        return (
            <Card>
                <CardContent className="py-8 text-center text-muted-foreground">
                    Unable to load water conditions
                </CardContent>
            </Card>
        );
    }

    const getScoreColor = (score: number) => {
        if (score >= 80) return 'text-green-500';
        if (score >= 60) return 'text-amber-500';
        return 'text-red-500';
    };

    const getScoreBadge = (score: number) => {
        if (score >= 80) return { text: 'Excellent', variant: 'default' as const };
        if (score >= 60) return { text: 'Good', variant: 'secondary' as const };
        if (score >= 40) return { text: 'Fair', variant: 'outline' as const };
        return { text: 'Poor', variant: 'destructive' as const };
    };

    return (
        <div className="space-y-6">
            {/* Fishing Score Card */}
            {fishingScore && (
                <motion.div
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                >
                    <Card className="bg-gradient-to-br from-forest-800 to-forest-900 border-forest-700">
                        <CardHeader>
                            <CardTitle className="text-white flex items-center gap-2">
                                <Activity className="w-5 h-5" />
                                Fishing Conditions Score
                            </CardTitle>
                            <CardDescription className="text-forest-200">
                                {spotName || 'Current location'}
                            </CardDescription>
                        </CardHeader>
                        <CardContent>
                            <div className="flex items-center justify-between mb-4">
                                <div>
                                    <div className={cn("text-5xl font-bold", getScoreColor(fishingScore.score))}>
                                        {fishingScore.score}
                                    </div>
                                    <p className="text-sm text-forest-300 mt-1">out of 100</p>
                                </div>
                                <Badge {...getScoreBadge(fishingScore.score)}>
                                    {getScoreBadge(fishingScore.score).text}
                                </Badge>
                            </div>

                            <div className="grid grid-cols-2 md:grid-cols-5 gap-4 mt-6">
                                <div>
                                    <p className="text-xs text-forest-400 mb-1">Temperature</p>
                                    <div className="flex items-center gap-1">
                                        <div className={cn("text-lg font-semibold", getScoreColor(fishingScore.factors.temperature))}>
                                            {fishingScore.factors.temperature}
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <p className="text-xs text-forest-400 mb-1">Pressure</p>
                                    <div className={cn("text-lg font-semibold", getScoreColor(fishingScore.factors.pressure))}>
                                        {fishingScore.factors.pressure}
                                    </div>
                                </div>
                                <div>
                                    <p className="text-xs text-forest-400 mb-1">Tides</p>
                                    <div className={cn("text-lg font-semibold", getScoreColor(fishingScore.factors.tides))}>
                                        {fishingScore.factors.tides}
                                    </div>
                                </div>
                                <div>
                                    <p className="text-xs text-forest-400 mb-1">Weather</p>
                                    <div className={cn("text-lg font-semibold", getScoreColor(fishingScore.factors.weather))}>
                                        {fishingScore.factors.weather}
                                    </div>
                                </div>
                                <div>
                                    <p className="text-xs text-forest-400 mb-1">Solunar</p>
                                    <div className={cn("text-lg font-semibold", getScoreColor(fishingScore.factors.solunar))}>
                                        {fishingScore.factors.solunar}
                                    </div>
                                </div>
                            </div>

                            <p className="text-forest-200 mt-4 text-sm">
                                {fishingScore.recommendation}
                            </p>
                        </CardContent>
                    </Card>
                </motion.div>
            )}

            {/* Current Conditions Grid */}
            <div className="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
                {/* Water Temperature */}
                <motion.div
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: 0.1 }}
                >
                    <Card>
                        <CardHeader className="flex flex-row items-center justify-between pb-2">
                            <CardTitle className="text-sm font-medium">
                                Water Temperature
                            </CardTitle>
                            <Thermometer className="w-4 h-4 text-muted-foreground" />
                        </CardHeader>
                        <CardContent>
                            <div className="text-2xl font-bold">
                                {conditions.temperature.toFixed(1)}°{conditions.temperatureUnit}
                            </div>
                            <p className="text-xs text-muted-foreground mt-1">
                                Optimal for most species
                            </p>
                        </CardContent>
                    </Card>
                </motion.div>

                {/* Wind */}
                <motion.div
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: 0.2 }}
                >
                    <Card>
                        <CardHeader className="flex flex-row items-center justify-between pb-2">
                            <CardTitle className="text-sm font-medium">Wind</CardTitle>
                            <Wind className="w-4 h-4 text-muted-foreground" />
                        </CardHeader>
                        <CardContent>
                            <div className="text-2xl font-bold">
                                {conditions.windSpeed.toFixed(1)} mph
                            </div>
                            <p className="text-xs text-muted-foreground mt-1">
                                {conditions.windDirection}° direction
                            </p>
                        </CardContent>
                    </Card>
                </motion.div>

                {/* Pressure */}
                <motion.div
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: 0.3 }}
                >
                    <Card>
                        <CardHeader className="flex flex-row items-center justify-between pb-2">
                            <CardTitle className="text-sm font-medium">
                                Barometric Pressure
                            </CardTitle>
                            <Activity className="w-4 h-4 text-muted-foreground" />
                        </CardHeader>
                        <CardContent>
                            <div className="text-2xl font-bold">
                                {conditions.pressure.toFixed(0)} hPa
                            </div>
                            <p className="text-xs text-muted-foreground mt-1 flex items-center gap-1">
                                {conditions.pressure > 1013 ? (
                                    <>
                                        <TrendingUp className="w-3 h-3" /> Rising
                                    </>
                                ) : (
                                    <>
                                        <TrendingDown className="w-3 h-3" /> Falling
                                    </>
                                )}
                            </p>
                        </CardContent>
                    </Card>
                </motion.div>

                {/* Visibility */}
                <motion.div
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: 0.4 }}
                >
                    <Card>
                        <CardHeader className="flex flex-row items-center justify-between pb-2">
                            <CardTitle className="text-sm font-medium">Visibility</CardTitle>
                            <Droplets className="w-4 h-4 text-muted-foreground" />
                        </CardHeader>
                        <CardContent>
                            <div className="text-2xl font-bold">
                                {(conditions.visibility / 1000).toFixed(1)} km
                            </div>
                            <p className="text-xs text-muted-foreground mt-1">
                                {conditions.visibility > 8000 ? 'Excellent' : 'Good'}
                            </p>
                        </CardContent>
                    </Card>
                </motion.div>
            </div>

            {/* Tide Chart */}
            {conditions.tides && conditions.tides.length > 0 && (
                <motion.div
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: 0.5 }}
                >
                    <Card>
                        <CardHeader>
                            <CardTitle className="flex items-center gap-2">
                                <Waves className="w-5 h-5" />
                                Tide Predictions
                            </CardTitle>
                            <CardDescription>Next 24 hours</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <div className="space-y-3">
                                {conditions.tides.slice(0, 6).map((tide, i) => (
                                    <div
                                        key={i}
                                        className="flex items-center justify-between p-3 rounded-lg bg-muted/50"
                                    >
                                        <div>
                                            <p className="font-medium">
                                                {tide.type === 'high' ? 'High Tide' : 'Low Tide'}
                                            </p>
                                            <p className="text-sm text-muted-foreground">
                                                {new Date(tide.time).toLocaleTimeString([], {
                                                    hour: '2-digit',
                                                    minute: '2-digit',
                                                })}
                                            </p>
                                        </div>
                                        <div className="text-right">
                                            <p className="text-lg font-bold">{tide.height.toFixed(2)} ft</p>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </CardContent>
                    </Card>
                </motion.div>
            )}

            {/* Current Data */}
            {conditions.currents && (
                <motion.div
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: 0.6 }}
                >
                    <Card>
                        <CardHeader>
                            <CardTitle>Water Currents</CardTitle>
                        </CardHeader>
                        <CardContent>
                            <div className="grid md:grid-cols-2 gap-4">
                                <div>
                                    <p className="text-sm text-muted-foreground mb-1">Speed</p>
                                    <p className="text-2xl font-bold">
                                        {conditions.currents.speed.toFixed(2)} knots
                                    </p>
                                </div>
                                <div>
                                    <p className="text-sm text-muted-foreground mb-1">Direction</p>
                                    <p className="text-2xl font-bold">
                                        {conditions.currents.direction}°
                                    </p>
                                </div>
                            </div>
                        </CardContent>
                    </Card>
                </motion.div>
            )}
        </div>
    );
};
